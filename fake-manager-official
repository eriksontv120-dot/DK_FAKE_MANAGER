        <label>${L('Units to keep at home (never used)', 'Rezerva jednotiek doma (nepoužije sa)')}</label>
        <div class="dk-row" style="flex-wrap:wrap">${SHOWN_UNITS.filter((u) => ALLOWED_UNITS.has(u)).map((u) => `<div style="min-width:70px">${unitIcon(u)}<input type="number" min="0" class="dk4-res" data-u="${u}" value="${esc((s.reserve || {})[u] || 0)}"></div>`).join('')}</div>
      </details>
    </div>
  </div>
  <div style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap;align-items:center">
    <button class="dk-btn dk4-busy" id="dk4-validate">${L('Check coordinates', 'Overiť súradnice')}</button>
    <button class="dk-btn pri dk4-busy" id="dk4-plan">${L('Check &amp; plan', 'Overiť a naplánovať')}</button>
    <button class="dk-btn dk4-busy" id="dk4-reload">↻ ${L('Refresh units', 'Aktualizovať jednotky')}</button>
    <button class="dk-btn dk4-busy" id="dk4-replanall">${L('Re-plan failed', 'Preplánovať chybné')}</button>
    <button class="dk-btn dk4-busy" id="dk4-clear">${L('Remove unsent', 'Vymazať neodoslané')}</button>
    <button class="dk-btn dk4-busy" id="dk4-clearhist">${L('Clear history', 'Vymazať históriu')}</button>
    <span class="dk-mut" id="dk4-snap"></span>
  </div>
  <div id="dk4-sendbox" style="display:none;margin-top:12px">
    <div style="display:flex;gap:8px;align-items:stretch;margin-bottom:6px;flex-wrap:wrap">
      <div id="dk4-sendinfo" style="flex:1;min-width:240px;color:#fff;background:#3d2f1a;padding:8px 12px;border-radius:6px;font-size:12px">${L('Rally point', 'Nádvorie')}</div>
      <button class="dk-btn big pri" id="dk4-next" style="min-width:190px">${L('NEXT ATTACK ▶', 'ĎALŠÍ ÚTOK ▶')}</button>
      <button class="dk-btn x" id="dk4-closeframe">${L('Close', 'Zavrieť')}</button>
    </div>
    <div class="dk-mut" style="margin-bottom:4px">${L('In the rally point click <b>Attack → Send attack</b>, then <b>NEXT ATTACK ▶</b>. If the bar is red, do not send the attack.', 'V nádvorí klikni <b>Útok → Poslať útok</b>, potom <b>ĎALŠÍ ÚTOK ▶</b>. Ak je pruh červený, útok neodosielaj.')}</div>
    <div class="dk4-framehost"></div>
  </div>
  <div id="dk4-dyn"></div>
</div>`;
        let box = $('#dk4fm');
        if (!box.length) {
            $('#dk4fm-style').remove();
            $('head').append(`<style id="dk4fm-style">${CSS}</style>`);
            box = $('<div id="dk4fm"></div>');
            $('#content_value').prepend(box);
            bind(box);
        }
        box.html(html);
    }

    function render() {
        let box = $('#dk4fm');
        if (!box.length || !box.find('#dk4-dyn').length) {
            renderStatic();
            box = $('#dk4fm');
        }
        const s = S();
        const c = counts();
        const pct = c.total ? Math.round((c.sent / c.total) * 100) : 0;
        const busy = session.running;
        const arr = buildArrival();
        const tb = (k, l) => `<div class="dk-tab ${view === k ? 'on' : ''}" data-view="${k}">${l}</div>`;
        const n = (st) => state.queue.filter((q) => (Array.isArray(st) ? st.includes(q.status) : q.status === st)).length;
        const nQueue = n(['pending', 'ready', 'progress', 'unverified', 'error']);

        box.find('#dk4-date').prop('disabled', !!s.autoDate);
        box.find('#dk4-autodays').prop('disabled', !s.autoDate);
        box.find('#dk4-arrinfo').html(arr.error
            ? `<span class="dk-err">${esc(arr.error)}</span>`
            : s.autoDate
                ? L(`Automatic: every day ${esc(s.from)} – ${esc(s.to)} (outside the night bonus), from today until ${fmtShort(arr.list[arr.list.length - 1][1]).slice(0, 6)}. Every attack lands on the nearest possible day.`,
                    `Automaticky: každý deň ${esc(s.from)} – ${esc(s.to)} (mimo nočného bonusu), od dnes do ${fmtShort(arr.list[arr.list.length - 1][1]).slice(0, 6)}. Každý útok dopadne v najbližšom možnom dni.`)
                : L('Allowed landing windows: ', 'Povolené okná dopadu: ') + arr.list.map(([a, b]) => `${fmtShort(a)} – ${fmtShort(b)}`).join('; '));
        box.find('#dk4-flinfo').html(L(`World fake limit: <b>${fakeLimit()} %</b> of the sending village's points ${s.fakeLimitOverride !== '' ? '(changed manually)' : '(from server)'}`,
            `Fake limit sveta: <b>${fakeLimit()} %</b> bodov vysielajúcej dediny ${s.fakeLimitOverride !== '' ? '(ručne zmenené)' : '(zo servera)'}`));
        box.find('#dk4-snap').text(L(`Units loaded ${snapshotAt ? fmtShort(snapshotAt) : '–'} · ${villages.length} villages`, `Jednotky načítané ${snapshotAt ? fmtShort(snapshotAt) : '–'} · ${villages.length} dedín`));
        box.find('.dk4-busy').prop('disabled', busy);
        box.find('.dk-lang button').prop('disabled', busy);

        const html = `
  ${lastReport ? `<div class="dk-rep">${lastReport}</div>` : ''}

  <div class="dk-prog">
    <b style="white-space:nowrap">${L('SENDING ATTACKS', 'ODOSIELANIE ÚTOKOV')}</b>
    <div class="dk-bar"><i style="width:${pct}%"></i><span>${c.sent} / ${c.total}</span></div>
    <span class="dk-stat dk-ok">${L('Sent', 'Odoslané')} <b>${c.sent}</b></span>
    <span class="dk-stat">${L('Waiting', 'Čakajúce')} <b>${c.waiting}</b> (${L('ready', 'pripravené')} ${c.ready})</span>
    <span class="dk-stat dk-err">${L('Errors', 'Chybné')} <b>${c.errors}</b></span>
    <span class="dk-stat">${L('Remaining', 'Zostáva')} <b>${c.rest}</b></span>
    ${session.running
        ? `<span class="dk-stat"><b>${L('Sending in progress', 'Odosielanie prebieha')}</b> – ${L('continue in the rally point below', 'pokračuj v nádvorí nižšie')}</span>`
        : `<button class="dk-btn big pri" id="dk4-batch" ${!c.ready ? 'disabled' : ''}>${L('START SENDING', 'ZAČAŤ ODOSIELANIE')} (${c.ready})</button>`}
  </div>

  <details id="dk4-list" ${listOpen ? 'open' : ''}><summary>📋 ${L(`Attack list – in queue ${nQueue}, sent ${n('sent')} (click to show)`, `Zoznam útokov – vo fronte ${nQueue}, odoslané ${n('sent')} (klikni pre zobrazenie)`)}</summary>
  ${listOpen ? `<div class="dk-tabs">
    ${tb('queue', `${L('Queue', 'Fronta')} (${nQueue})`)}
    ${tb('sent', `${L('Sent', 'Odoslané')} (${n('sent')})`)}
    ${tb('removed', `${L('Removed', 'Odstránené')} (${n('removed')})`)}
    ${tb('all', `${L('All', 'Všetko')} (${state.queue.length})`)}
  </div>
  <div class="dk-tw">${renderTable()}</div>` : ''}
  </details>

  <details id="dk4-vill" ${villagesOpen ? 'open' : ''}><summary>${L('Own villages and their classification', 'Vlastné dediny a ich klasifikácia')} (${villages.length})</summary>${villagesOpen ? renderVillages() : ''}</details>`;
        box.find('#dk4-dyn').html(html);
    }

    function renderTable() {
        const t = now();
        const rows = sortedQueue().filter((q) => (view === 'queue' ? ACTIVE.has(q.status) : view === 'all' ? true : q.status === view));
        if (!rows.length) return `<div style="padding:16px" class="dk-mut">${L('No attacks in this list.', 'Žiadne útoky v tomto zozname.')}</div>`;
        const busy = session.running;
        return `<table class="dk-t"><thead><tr>
<th>#</th><th>${L('Target', 'Cieľ')}</th><th>${L('Sending village', 'Vysielajúca dedina')}</th><th>${L('Type', 'Typ')}</th><th>${L('Units', 'Zostava')}</th><th>${L('Send time', 'Čas odoslania')}</th><th>${L('Landing time', 'Čas dopadu')}</th><th>${L('Status', 'Stav')}</th><th>${L('Actions', 'Akcie')}</th>
</tr></thead><tbody>${rows.map((q) => {
            const stc = STATUS[q.status].c;
            const sw = sendWindows(q.arrival, q.travel, q.buffer, t);
            let sendCell = '';
            let landCell = '';
            if (q.status === 'sent') {
                sendCell = `${fmt(q.sentAt)}`;
                landCell = fmt(q.sentAt + q.travel);
            } else if (q.status === 'removed') {
                sendCell = '–';
                landCell = '–';
            } else if (sw.length) {
                const open = t >= sw[0][0];
                sendCell = `${open ? `<b class="dk-ok">${L('now', 'teraz')}</b>` : fmt(sw[0][0])}<br><span class="dk-mut">${L('latest', 'najneskôr')} ${fmtShort(sw[sw.length - 1][1])}${open ? '' : ` · ${L('in', 'o')} <span class="dk4-cd" data-t="${sw[0][0]}">${fmtDur((sw[0][0] - t) / 1000)}</span>`}</span>`;
                landCell = `${fmt(Math.max(t, sw[0][0]) + q.travel)}<br><span class="dk-mut">${L('travel', 'pochod')} ${fmtDur(q.travel / 1000)} · ${q.dist.toFixed(1)} ${L('fields', 'polí')}</span>`;
            } else {
                sendCell = `<span class="dk-err">${L('window passed', 'okno uplynulo')}</span>`;
                landCell = '–';
            }
            const tk = q.targetInfo && q.targetInfo.kind;
            const tkTxt = {
                barb: L('barbarian', 'barbarská'), player: L('player', 'hráč'), own: L('own', 'vlastná'),
                unknown: L('not checked', 'neoverené'), missing: L('does not exist', 'neexistuje'),
            }[tk] || '';
            let actions = '';
            if (q.status === 'ready' || q.status === 'pending') {
                actions += `<button class="dk-btn sm send" data-act="send" data-id="${q.id}" ${q.status === 'ready' ? '' : 'disabled'}>${L('OPEN', 'OTVORIŤ')}</button> `;
            }
            if (q.status === 'unverified') {
                actions += `<button class="dk-btn sm" data-act="verify" data-id="${q.id}" ${busy ? 'disabled' : ''}>${L('Verify', 'Overiť znova')}</button> <button class="dk-btn sm" data-act="marksent" data-id="${q.id}" ${busy ? 'disabled' : ''}>${L('Was sent', 'Bol odoslaný')}</button> <button class="dk-btn sm" data-act="back" data-id="${q.id}" ${busy ? 'disabled' : ''}>${L('Was not sent', 'Nebol odoslaný')}</button> `;
            }
            if (q.status === 'error') actions += `<button class="dk-btn sm" data-act="replan" data-id="${q.id}" ${busy ? 'disabled' : ''}>${L('Re-plan', 'Preplánovať')}</button> <button class="dk-btn sm" data-act="recheck" data-id="${q.id}" ${busy ? 'disabled' : ''}>${L('Re-check', 'Skontrolovať')}</button> `;
            if (['pending', 'ready', 'error'].includes(q.status)) actions += `<button class="dk-btn sm x" data-act="cancel" data-id="${q.id}">${L('CANCEL', 'ZRUŠIŤ')}</button>`;
            if (q.status === 'progress') actions += `<span class="dk-mut">${L('send it in the rally point below', 'odošli v nádvorí nižšie')}</span>`;
            const why = openWhy.has(q.id)
                ? `<tr class="st-${q.status}"><td></td><td colspan="8"><div class="dk-why"><b>${L('Why this plan:', 'Prečo tento plán:')}</b><ul>${q.why.map((w) => `<li>${esc(w)}</li>`).join('')}</ul>${q.log && q.log.length ? `<b>${L('History:', 'História:')}</b><ul>${q.log.map((w) => `<li>${esc(w)}</li>`).join('')}</ul>` : ''}<span class="dk-mut">ID: ${esc(q.id)}${q.commandId ? L(' · command #', ' · príkaz #') + esc(q.commandId) : ''}</span></div></td></tr>`
                : '';
            return `<tr class="st-${q.status}" data-row="${q.id}">
<td>${q.no}</td>
<td><b>${esc(q.target)}</b><br><span class="dk-mut">${esc(tkTxt)}</span></td>
<td><a href="/game.php?${SITTER}village=${q.sourceId}&screen=overview" target="_blank">${esc(q.sourceName)}</a><br><span class="dk-mut">${fmtNum(q.sourcePoints)} ${L('pts', 'b.')}</span></td>
<td><span class="dk-k ${q.kind}">${q.kind} FAKE</span></td>
<td>${unitsHtml(q.units)}<br><span class="dk-mut">${esc(variantName(q.units))} · ${q.pop} ${popWord()} (min ${q.minPop})</span></td>
<td>${sendCell}</td>
<td>${landCell}</td>
<td><span class="dk-st" style="background:${stc}">${stLabel(q.status)}</span>${q.reason ? `<br><span class="dk-mut" style="color:${stc}">${esc(q.reason)}</span>` : ''}</td>
<td>${actions} <button class="dk-btn sm" data-act="why" data-id="${q.id}" title="${L('Why this village was chosen', 'Prečo bola vybraná táto dedina')}">?</button></td>
</tr>${why}`;
        }).join('')}</tbody></table>`;
    }

    function renderVillages() {
        if (!villages.length) return `<p class="dk-mut">${L('Villages are not loaded yet.', 'Dediny ešte nie sú načítané.')}</p>`;
        const reserved = reservedMap();
        const ov = S().override || {};
        const rows = villages.map((v) => {
            const c = classify(v);
            const av = available(v, reserved);
            let use = '';
            if (c.type === 'OFF' || c.type === 'DEFF') {
                const comp = composeFake(v, c.type, av);
                use = comp.ok ? `<span class="dk-ok">${L('usable', 'použiteľná')} – ${esc(unitsText(comp.units))}</span>` : `<span class="dk-err">${L('not usable', 'nepoužiteľná')} – ${esc(comp.reason)}</span>`;
            } else use = `<span class="dk-err">${L('not usable', 'nepoužiteľná')} – ${esc(c.why)}</span>`;
            return `<tr><td>${esc(v.name)}</td><td>${fmtNum(v.points)}</td><td>${v.points ? minPopFor(v) : '–'}</td>
${SHOWN_UNITS.map((u) => `<td title="${L('at home', 'doma')} ${v.troops[u] || 0}">${av[u] || 0}</td>`).join('')}
<td>${c.type === 'OFF' || c.type === 'DEFF' ? `<span class="dk-k ${c.type}">${c.type}</span>` : c.type === 'SKIP' ? L('excluded', 'vylúčená') : '–'}<br><span class="dk-mut">${esc(c.why)}</span></td>
<td><select class="dk4-ov" data-id="${v.id}">${['auto', 'off', 'deff', 'skip'].map((o) => `<option value="${o}" ${(ov[v.id] || 'auto') === o ? 'selected' : ''}>${{ auto: 'Auto', off: 'OFF', deff: 'DEFF', skip: L('Exclude', 'Vylúčiť') }[o]}</option>`).join('')}</select></td>
<td>${use}</td></tr>`;
        });
        return `<div class="dk-tw"><table class="dk-t"><thead><tr><th>${L('Village', 'Dedina')}</th><th>${L('Points', 'Body')}</th><th>${L('Min. pop.', 'Min. obyv.')}</th>${SHOWN_UNITS.map((u) => `<th>${unitIcon(u)}</th>`).join('')}<th>${L('Type', 'Typ')}</th><th>${L('Setting', 'Nastavenie')}</th><th>${L('Fake (free units)', 'Fake (voľné jednotky)')}</th></tr></thead><tbody>${rows.join('')}</tbody></table></div>
<p class="dk-mut">${L('Unit numbers = free (at home − reserve − reserved in queue). Heavy cavalry is shown only for classification and is never used in fakes.', 'Čísla jednotiek = voľné (doma − rezerva − rezervované vo fronte). Ťažká jazda sa zobrazuje len na klasifikáciu, do fejkov sa nikdy nepoužije.')}</p>`;
    }

    function readSettings(box) {
        const s = S();
        s.coords = box.find('#dk4-coords').val();
        s.perTarget = num(box.find('#dk4-per').val()) || 1;
        s.allowDup = box.find('#dk4-dup').is(':checked');
        s.date = box.find('#dk4-date').val();
        s.autoDate = box.find('#dk4-auto').is(':checked');
        s.autoDays = Math.max(1, Math.min(60, num(box.find('#dk4-autodays').val()) || 14));
        s.from = box.find('#dk4-from').val();
        s.to = box.find('#dk4-to').val();
        if (/^\d{1,2}:\d{2}$/.test(s.from)) s.from += ':00';
        if (/^\d{1,2}:\d{2}$/.test(s.to)) s.to += ':00';
        s.forbidden = box.find('#dk4-forb').val();
        s.kind = box.find('#dk4-kind').val();
        if (box.find('#dk4-offo').length) {
            s.offOrder = box.find('#dk4-offo').val();
            s.deffOrder = box.find('#dk4-defo').val();
            s.maxRams = Math.max(1, num(box.find('#dk4-maxr').val()));
            s.maxPerVillage = num(box.find('#dk4-maxv').val());
            s.bufferSec = num(box.find('#dk4-buf').val());
            s.fakeLimitOverride = String(box.find('#dk4-fl').val() || '').trim();
            s.reserve = s.reserve || {};
            box.find('.dk4-res').each(function () { s.reserve[$(this).data('u')] = num($(this).val()); });
        }
        save();
    }

    function reportValidation(v) {
        const st = v.stats;
        const dupTxt = v.dup.length ? L(` · repeated ${v.dup.length}${S().allowDup ? ' (kept)' : ' (removed)'}`, ` · opakované ${v.dup.length}${S().allowDup ? ' (ponechané)' : ' (odstránené)'}`) : '';
        return `${L('<b>Coordinate check:</b> entered', '<b>Overenie súradníc:</b> zadané')} ${v.total} · ${L('valid', 'platné')} ${v.targets.length}${dupTxt}
 · ${L('barbarian', 'barbarské')} ${st.barb} · ${L('player', 'hráčske')} ${st.player} · ${L('own', 'vlastné')} ${st.own} · ${L('not existing', 'neexistujú')} ${st.missing}${st.unknown ? ` · ${L('not checked', 'neoverené')} ${st.unknown}` : ''}
${v.invalid.length ? `<br><span class="dk-err">${L('Invalid', 'Neplatné')}: ${esc(v.invalid.slice(0, 30).join(', '))}${v.invalid.length > 30 ? '…' : ''}</span>` : ''}
${v.mapErr ? `<br><span class="dk-err">${L(`World map could not be loaded (${esc(v.mapErr)}) – target existence is not checked.`, `Mapu sveta sa nepodarilo načítať (${esc(v.mapErr)}) – existencia cieľov nie je overená.`)}</span>` : ''}
${st.own ? `<br><span class="dk-err">${L('Own villages are not allowed as targets.', 'Vlastné dediny nie sú povolené ako cieľ.')}</span>` : ''}`;
    }

    function bind(box) {
        box.on('change', 'input,select,textarea', function () {
            if ($(this).hasClass('dk4-ov')) {
                const s = S();
                s.override = s.override || {};
                s.override[$(this).data('id')] = $(this).val();
                save();
                villagesOpen = true;
                render();
                return;
            }
            readSettings(box);
            if (/dk4-(date|from|to|forb|fl|auto|autodays)/.test(this.id)) render();
        });
        box.on('input', '#dk4-coords', () => {
            S().coords = box.find('#dk4-coords').val();
            save();
        });
        box.on('click', '.dk-lang button', function () {
            if (session.running) return;
            const l = $(this).data('lang') === 'sk' ? 'sk' : 'en';
            if (l === LANG) return;
            readSettings(box);
            S().lang = l;
            LANG = l;
            save();
            lastReport = '';
            renderStatic();
            render();
        });
        box.on('click', '#dk4-list > summary', (e) => {
            e.preventDefault();
            listOpen = !listOpen;
            render();
        });
        box.on('click', '#dk4-vill > summary', (e) => {
            e.preventDefault();
            villagesOpen = !villagesOpen;
            render();
        });
        box.on('click', '[data-view]', function () {
            view = $(this).data('view');
            render();
        });
        box.on('click', '#dk4-close', () => {
            if (session.running) return alert(L('Close the rally point (sending) first.', 'Najprv zavri nádvorie (odosielanie).'));
            clearInterval(window.__dk4fmTicker);
            box.remove();
        });
        box.on('click', '#dk4-validate', async () => {
            readSettings(box);
            lastReport = L('Checking coordinates…', 'Overujem súradnice…');
            render();
            const v = await validateTargets();
            lastReport = reportValidation(v);
            render();
        });
        box.on('click', '#dk4-plan', async () => {
            readSettings(box);
            if (!villages.length) return alert(L('Villages are not loaded.', 'Dediny nie sú načítané.'));
            lastReport = L('Checking coordinates and planning…', 'Overujem súradnice a plánujem…');
            render();
            const v = await validateTargets();
            if (!v.targets.length) {
                lastReport = reportValidation(v) + `<br><span class="dk-err">${L('No valid coordinates.', 'Žiadne platné súradnice.')}</span>`;
                return render();
            }
            const res = planTargets(v.targets);
            if (res.error) lastReport = reportValidation(v) + `<br><span class="dk-err">${esc(res.error)}</span>`;
            else {
                const offN = res.created.filter((q) => q.kind === 'OFF').length;
                const removedTxt = res.removed && res.removed.length
                    ? `<br><span class="dk-mut">${L('Excluded from the window', 'Z okna vylúčené')}: ${esc(res.removed.slice(0, 3).join('; '))}${res.removed.length > 3 ? ` … (+${res.removed.length - 3})` : ''}</span>` : '';
                const timeTxt = res.timeFails && !S().autoDate
                    ? `<br><b class="dk-err">${L(`${res.timeFails} targets cannot land on the chosen date.`, `${res.timeFails} cieľov nestihne dopadnúť v zadanom dátume.`)}</b> ${L('Turn on <b>Automatic date</b> or choose a later landing date.', 'Zapni <b>Automatický dátum</b> alebo nastav neskorší dátum dopadu.')}` : '';
                const failTxt = res.failed.length
                    ? `<br><span class="dk-err">${L('Not planned', 'Nenaplánované')}: ${res.failed.length}</span><ul style="margin:2px 0;padding-left:16px">${res.failed.slice(0, 50).map((f) => `<li>${esc(f.t.coord)} – ${esc(f.why)}</li>`).join('')}</ul>` : '';
                lastReport = `${reportValidation(v)}<br><b class="dk-ok">${L('Planned', 'Naplánované')}: ${res.created.length}</b> (OFF ${offN}, DEFF ${res.created.length - offN})${removedTxt}${timeTxt}${failTxt}`;
            }
            view = 'queue';
            tick(true);
        });
        box.on('click', '#dk4-reload', async () => {
            lastReport = L('Loading villages and units…', 'Načítavam dediny a jednotky…');
            render();
            try {
                await loadVillages();
                lastReport = L(`Units refreshed (${villages.length} villages).`, `Jednotky aktualizované (${villages.length} dedín).`);
            } catch (e) {
                lastReport = `<span class="dk-err">${esc(e.message)}</span>`;
            }
            tick(true);
        });
        box.on('click', '#dk4-replanall', () => {
            const errs = state.queue.filter((q) => q.status === 'error');
            if (!errs.length) return;
            let ok = 0;
            errs.forEach((q) => { const r = replan(q); if (r && r.created && r.created.length) ok++; });
            lastReport = L(`Re-planned: ${ok} of ${errs.length} failed attacks.`, `Preplánované: ${ok} z ${errs.length} chybných útokov.`);
            tick(true);
        });
        box.on('click', '#dk4-clear', () => {
            const act = state.queue.filter((q) => ['pending', 'ready', 'error'].includes(q.status));
            if (!act.length || !confirm(L(`Remove ${act.length} unsent attacks from the queue? Reserved units will be released.`, `Odstrániť ${act.length} neodoslaných útokov z fronty? Rezervované jednotky sa uvoľnia.`))) return;
            act.forEach((q) => { q.status = 'removed'; q.reason = L('Removed in bulk', 'Hromadne odstránené'); log(q, L('Removed', 'Odstránený')); });
            save();
            render();
        });
        box.on('click', '#dk4-clearhist', () => {
            const h = state.queue.filter((q) => q.status === 'sent' || q.status === 'removed');
            if (!h.length || !confirm(L(`Clear history (${h.length} sent/removed)?`, `Vymazať históriu (${h.length} odoslaných/odstránených)?`))) return;
            state.queue = state.queue.filter((q) => !(q.status === 'sent' || q.status === 'removed'));
            save();
            render();
        });
        box.on('click', '#dk4-batch', startSession);
        box.on('click', '#dk4-next', () => nextAttack(true));
        box.on('click', '#dk4-closeframe', () => endSession(L('Sending finished.', 'Odosielanie ukončené.')));
        box.on('click', '[data-act]', async function () {
            const id = $(this).data('id');
            const item = state.queue.find((q) => q.id === id);
            if (!item) return;
            const act = $(this).data('act');
            if (act === 'why') {
                openWhy.has(id) ? openWhy.delete(id) : openWhy.add(id);
                return render();
            }
            if (act === 'send') {
                if (!session.running) session = { running: true, current: null, skipped: new Set() };
                if (!settleCurrent(true)) return;
                const err = openSend(item);
                if (err) {
                    alert(L(`Attack #${item.no} cannot be opened now:\n${err}`, `Útok #${item.no} sa teraz nedá otvoriť:\n${err}`));
                    if (!session.current || session.current.status !== 'progress') endSession();
                }
                return;
            }
            if (act === 'cancel') {
                if (!['pending', 'ready', 'error'].includes(item.status)) return;
                item.status = 'removed';
                item.reason = L('Cancelled by user', 'Zrušený používateľom');
                log(item, L('Cancelled – units released', 'Zrušený – jednotky uvoľnené'));
                save();
                return tick(true);
            }
            if (act === 'replan') {
                const r = replan(item);
                lastReport = r && r.created && r.created.length
                    ? L(`Attack to ${item.target} re-planned (new #${r.created[0].no}).`, `Útok na ${item.target} preplánovaný (nový #${r.created[0].no}).`)
                    : `<span class="dk-err">${L(`No other suitable village found for ${esc(item.target)}`, `Pre ${esc(item.target)} sa nenašla iná vhodná dedina`)}${r && r.failed && r.failed[0] ? ': ' + esc(r.failed[0].why) : ''}.</span>`;
                return tick(true);
            }
            if (act === 'recheck') {
                item.status = 'pending';
                item.reason = '';
                return tick(true);
            }
            if (act === 'verify') {
                item.reason = L('Verifying…', 'Overujem…');
                render();
                const r = await verifySent(item);
                if (r.found) markSent(item, r, L('manual check', 'ručné overenie'));
                else item.reason = L('The command was still not found in the overview.', 'Príkaz sa v prehľade stále nenašiel.');
                save();
                return render();
            }
            if (act === 'marksent') {
                if (!confirm(L('Was the attack really sent in the game? (Check the commands overview.)', 'Naozaj bol útok odoslaný v hre? (Skontroluj v prehľade príkazov.)'))) return;
                markSent(item, null, L('confirmed by user', 'potvrdené používateľom'));
                return render();
            }
            if (act === 'back') {
                if (!confirm(L('The attack was NOT sent – put it back into the queue?', 'Útok NEBOL odoslaný – vrátiť ho do fronty?'))) return;
                item.status = 'pending';
                item.reason = '';
                log(item, L('Put back into the queue by user', 'Vrátený do fronty používateľom'));
                save();
                return tick(true);
            }
        });
    }

    // Tick every second: clock, countdowns, status changes (display only).
    let lastSig = '';
    function tick(forceRender) {
        const t = now();
        const reserved = reservedMap();
        state.queue.forEach((q) => evaluate(q, t, reserved));
        const sig = state.queue.map((q) => q.status + (q.reason || '')).join('|') + '|' + Math.floor(t / 60000);
        if (forceRender || sig !== lastSig) {
            lastSig = sig;
            save();
            render();
        } else {
            $('#dk4-clock').text(fmt(t));
            $('#dk4fm .dk4-cd').each(function () { $(this).text(fmtDur((+$(this).data('t') - t) / 1000)); });
        }
    }

    /* ------------------------------------------------------------------ */
    /*  Start                                                              */
    /* ------------------------------------------------------------------ */
    $('#dk4fm').remove();
    if (window.__dk4fmTicker) clearInterval(window.__dk4fmTicker);
    $('#content_value').prepend(`<div id="dk4fm-loading" style="padding:10px;background:#f4e4bc;border:1px solid #c6a768;margin:8px 0">${L('DK4: loading world settings, villages and units…', 'DK4: načítavam nastavenia sveta, dediny a jednotky…')}</div>`);
    try {
        await loadWorldConfig(false);
        await loadVillages();
    } catch (e) {
        $('#dk4fm-loading').html(`<b style="color:#c62828">${L('DK4 error', 'DK4 chyba')}:</b> ${esc(e.message)}`);
        console.error('DK4', e);
        return;
    }
    $('#dk4fm-loading').remove();
    render();
    window.__dk4fmTicker = setInterval(() => tick(false), 1000);
    tick(true);
})();
