        <div><label>&nbsp;</label><label style="margin-top:6px"><input type="checkbox" id="dk4-dup" ${s.allowDup ? 'checked' : ''}> ${L('allow repeated coordinates', 'povoliť opakované súradnice')}</label></div>
      </div>
    </div>
    <div class="dk-card">
      <h4>2 · ${L('Landing time', 'Čas dopadu')}</h4>
      <label style="font-weight:bold;color:#2e7d32"><input type="checkbox" id="dk4-auto" ${s.autoDate ? 'checked' : ''}> ${L('Automatic date (nearest possible day by travel time)', 'Automatický dátum (najbližší možný deň podľa času pochodu)')}</label>
      <div class="dk-row">
        <div><label>${L('Landing date', 'Dátum dopadu')}</label><input type="date" id="dk4-date" value="${esc(s.date)}"></div>
        <div><label>${L('Search days ahead', 'Hľadať dní dopredu')}</label><input type="number" id="dk4-autodays" min="1" max="60" value="${esc(s.autoDays)}"></div>
      </div>
      <div class="dk-row">
        <div><label>${L('Earliest', 'Najskôr')}</label><input type="time" step="1" id="dk4-from" value="${esc(s.from)}"></div>
        <div><label>${L('Latest', 'Najneskôr')}</label><input type="time" step="1" id="dk4-to" value="${esc(s.to)}"></div>
      </div>
      <label>${L('Forbidden intervals (daily, e.g. 12:00-13:00, 18:00-18:30)', 'Zakázané intervaly (denne, napr. 12:00-13:00, 18:00-18:30)')}</label>
      <input type="text" id="dk4-forb" value="${esc(s.forbidden)}">
      <div class="dk-mut" style="margin-top:6px">
        ${L('World night bonus', 'Nočný bonus sveta')}: ${cfg.night.active ? `<b>${pad(cfg.night.start)}:00 – ${pad(cfg.night.end)}:00</b> (${L('excluded automatically', 'vylúčený automaticky')})` : `<b>${L('off', 'vypnutý')}</b>`}<br>
        <span id="dk4-arrinfo"></span>
      </div>
    </div>
    <div class="dk-card">
      <h4>3 · ${L('Fake type', 'Typ fejkov')}</h4>
      <label>${L('Sending villages', 'Vysielajúce dediny')}</label>
      <select id="dk4-kind">
        <option value="mix" ${s.kind === 'mix' ? 'selected' : ''}>${L('OFF and DEFF (automatic mix)', 'OFF aj DEFF (automatický mix)')}</option>
