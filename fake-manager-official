  </details>
  <div class="dk-grid">
    <div class="dk-card">
      <h4>1 · ${L('Target coordinates', 'Cieľové súradnice')}</h4>
      <textarea id="dk4-coords" placeholder="500|500 501|499 ...">${esc(s.coords)}</textarea>
      <div class="dk-row">
