  <span class="dk-lang" title="${L('Language', 'Jazyk')}"><button data-lang="en" class="${LANG === 'en' ? 'on' : ''}">EN</button><button data-lang="sk" class="${LANG === 'sk' ? 'on' : ''}">SK</button></span>
