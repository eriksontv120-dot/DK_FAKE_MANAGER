        </div>
        <div class="dk-row">
          <div><label>${L('Confirmation buffer (s)', 'Rezerva na potvrdenie (s)')}</label><input type="number" id="dk4-buf" min="0" value="${esc(s.bufferSec)}"></div>
          <div><label>${L('Fake limit % (empty = from server)', 'Fake limit % (prázdne = zo servera)')}</label><input type="text" id="dk4-fl" value="${esc(s.fakeLimitOverride)}"></div>
